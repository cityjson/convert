{
  "name": "@cityjson/cjconv",
  "version": "0.1.0",
  "description": "Convert between 3D city model formats (CityJSON, CityJSONSeq, FlatCityBuf, CityParquet, OBJ) from the command line or Node, with the cityjson DuckDB extension.",
  "keywords": [
    "3d-city-model",
    "cityjson",
    "cityjsonseq",
    "cityparquet",
    "cli",
    "duckdb",
    "flatcitybuf",
    "obj"
  ],
  "homepage": "https://github.com/cityjson/convert#readme",
  "bugs": {
    "url": "https://github.com/cityjson/convert/issues"
  },
  "license": "MIT",
  "author": "HideBa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cityjson/convert.git",
    "directory": "packages/cjconv"
  },
  "bin": {
    "cjconv": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@cityjson/cjconv-core": "workspace:*",
    "@duckdb/node-api": "1.5.6-r.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}
