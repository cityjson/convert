  "keywords": [
    "3d-city-model",
    "cityjson",
    "cityjsonseq",
    "cityparquet",
    "duckdb",
    "flatcitybuf",
    "obj"
  ],
  "homepage": "https://github.com/cityjson/convert#readme",
  "bugs": {
    "url": "https://github.com/cityjson/convert/issues"
  },
  "license": "MIT",
  "author": "HideBa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cityjson/convert.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "prepublishOnly": "vp run build"
  },
